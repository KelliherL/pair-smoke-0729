{
  "version": 1,
  "description": "Drives pair-init's overlay onto a target repo. kind: verbatim = copy as-is; parameterized = fill {{VARS}}; stub = contains <!-- pf:begin NAME --> blocks the installer authors from interview answers; generated = built fresh at init. onConflict: what to do when the target already has the file.",
  "kitOnly": [
    "README.md",
    "INSTALL.md",
    "pair-factory.manifest.json",
    "pairing.example.json",
    "schemas/",
    "kit-templates/",
    "kit/"
  ],
  "files": [
    { "path": ".gitattributes", "kind": "verbatim", "onConflict": "merge" },
    { "path": ".gitignore", "kind": "verbatim", "onConflict": "merge" },
    { "path": "CLAUDE.md", "kind": "verbatim", "onConflict": "skip" },
    { "path": "AGENTS.md", "kind": "stub", "vars": ["PROJECT_NAME", "PROJECT_DESCRIPTION", "RUNTIME_REQUIREMENT", "HUMANS_TABLE", "BOARD_URL", "DEFAULT_BRANCH", "SETUP_CMD", "TEST_CMD", "TYPECHECK_CMD", "LINT_CMD"], "onConflict": "writeBeside" },
    { "path": "pairing.json", "kind": "generated", "onConflict": "abort" },
    { "path": ".claude/settings.json", "kind": "parameterized", "vars": ["TEST_CMD", "TYPECHECK_CMD", "LINT_CMD", "SETUP_CMD"], "onConflict": "writeBeside" },
    { "path": ".claude/skills/plan/SKILL.md", "kind": "verbatim", "onConflict": "writeBeside" },
    { "path": ".claude/skills/build/SKILL.md", "kind": "verbatim", "onConflict": "writeBeside" },
    { "path": ".claude/skills/verify/SKILL.md", "kind": "stub", "vars": [], "onConflict": "writeBeside" },
    { "path": ".claude/skills/decompose/SKILL.md", "kind": "verbatim", "onConflict": "writeBeside" },
    { "path": ".claude/skills/complete-assigned-work/SKILL.md", "kind": "verbatim", "onConflict": "writeBeside" },
    { "path": ".claude/skills/retro/SKILL.md", "kind": "verbatim", "onConflict": "writeBeside" },
    { "path": ".github/ISSUE_TEMPLATE/backlog-issue.md", "kind": "parameterized", "vars": ["BOARD_URL"], "onConflict": "writeBeside" },
    { "path": ".github/ISSUE_TEMPLATE/adr.md", "kind": "verbatim", "onConflict": "writeBeside" },
    { "path": ".github/pull_request_template.md", "kind": "stub", "vars": ["TYPECHECK_CMD", "TEST_CMD"], "onConflict": "writeBeside" },
    { "path": ".github/workflows/ci.yml", "kind": "generated", "from": "kit-templates/ci.yml.tmpl", "vars": ["SETUP_STEPS", "TYPECHECK_CMD", "TEST_CMD"], "onConflict": "writeBeside" },
    { "path": ".github/ruleset-main.json", "kind": "parameterized", "vars": ["DEFAULT_BRANCH"], "onConflict": "replace" },
    { "path": "docs/adr/0000-template.md", "kind": "verbatim", "onConflict": "skip" },
    { "path": "docs/adr/README.md", "kind": "stub", "vars": [], "onConflict": "skip" },
    { "path": "docs/architecture.md", "kind": "generated", "onConflict": "skip" },
    { "path": "docs/testing-notes.md", "kind": "verbatim", "onConflict": "skip" },
    { "path": "docs/backlog.md", "kind": "parameterized", "vars": ["AREA_LABELS"], "onConflict": "skip" },
    { "path": "scripts/lib.sh", "kind": "verbatim", "onConflict": "replace" },
    { "path": "scripts/adr.sh", "kind": "verbatim", "onConflict": "replace" },
    { "path": "scripts/assigned.sh", "kind": "verbatim", "onConflict": "replace" },
    { "path": "scripts/verify.sh", "kind": "verbatim", "onConflict": "replace" },
    { "path": "scripts/verify-prompt-diff.md", "kind": "verbatim", "onConflict": "replace" },
    { "path": "scripts/verify-prompt-full.md", "kind": "verbatim", "onConflict": "replace" },
    { "path": "scripts/watch.sh", "kind": "verbatim", "onConflict": "replace" },
    { "path": "scripts/decompose.sh", "kind": "verbatim", "onConflict": "replace" },
    { "path": "scripts/README.md", "kind": "verbatim", "onConflict": "writeBeside" }
  ]
}
