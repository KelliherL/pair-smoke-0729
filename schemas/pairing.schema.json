{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pair-factory pairing.json",
  "type": "object",
  "required": ["version", "project", "humans", "commands", "verify"],
  "properties": {
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["name", "defaultBranch"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "defaultBranch": { "type": "string", "minLength": 1 },
        "prdPattern": { "type": "string", "default": "docs/prd*.md" }
      }
    },
    "humans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["login", "name"],
        "properties": {
          "login": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "cli": { "enum": ["claude", "codex", "other"], "default": "other" }
        }
      }
    },
    "commands": {
      "type": "object",
      "required": ["test"],
      "properties": {
        "setup": { "type": "string" },
        "test": { "type": "string" },
        "typecheck": { "type": "string" },
        "lint": { "type": "string" }
      }
    },
    "verify": {
      "type": "object",
      "required": ["tool"],
      "properties": {
        "tool": { "enum": ["codex", "auto", "none"] },
        "model": { "type": "string", "default": "gpt-5.6-terra" },
        "reasoningEffort": {
          "enum": ["minimal", "low", "medium", "high", "xhigh"],
          "default": "high"
        },
        "mode": { "enum": ["diff", "full"], "default": "diff" },
        "timeoutMinutes": { "type": "integer", "minimum": 1, "default": 15 },
        "verdictRequired": {
          "type": "object",
          "properties": {
            "labels": { "type": "array", "items": { "type": "string" } },
            "paths": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "board": {
      "type": "object",
      "description": "Written by pair-init discovery. projectNumber 0 = no board (board flips become no-ops).",
      "properties": {
        "owner": { "type": "string" },
        "projectNumber": { "type": "integer" },
        "projectId": { "type": "string" },
        "stageFieldId": { "type": "string" },
        "stageOptionIds": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "sessionLogIssue": {
      "type": "integer",
      "description": "Number of the pinned Session log issue. 0 = not yet created."
    }
  }
}
