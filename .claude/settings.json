{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git stash:*)",
      "Bash(gh api user:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh project item-list:*)",
      "Bash(gh project item-edit:*)",
      "Bash(gh project item-add:*)",
      "Bash(scripts/assigned.sh)",
      "Bash(bash scripts/assigned.sh)",
      "Bash(scripts/verify.sh:*)",
      "Bash(bash scripts/verify.sh:*)",
      "Bash(scripts/watch.sh:*)",
      "Bash(bash scripts/watch.sh:*)",
      "Bash(scripts/adr.sh:*)",
      "Bash(bash scripts/adr.sh:*)",
      "Bash(scripts/decompose.sh:*)",
      "Bash(bash scripts/decompose.sh:*)",
      "Bash(jq:*)",
      "Bash({{SETUP_CMD}}:*)",
      "Bash({{TEST_CMD}}:*)",
      "Bash({{TYPECHECK_CMD}}:*)",
      "Bash({{LINT_CMD}}:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(tree:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
